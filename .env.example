# Root Docker Compose environment (NOT the Laravel app .env).
# Copy to `.env` in this directory before starting Docker:
#   cp .env.example .env
#
# Laravel app env lives in `src/.env` (see `src/.env.example`).

COMPOSE_PROJECT_NAME=shopify-laravel-starter

DB_DATABASE=shopify_starter
DB_USERNAME=shopify
DB_PASSWORD=secret

MYSQL_ROOT_PASSWORD=root
