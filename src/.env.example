APP_NAME="Shopify Laravel Starter"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://your-tunnel-subdomain.ngrok-free.dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker Compose MySQL service hostname is `mysql`
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=shopify_starter
DB_USERNAME=shopify
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Docker Compose Redis service hostname is `redis`
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Shopify (Partners / Dev Dashboard)
# -----------------------------------------------------------------------------
# Create an app in Shopify Partners, then copy Client ID / Secret here.
# APP_URL and SHOPIFY_APP_URL must match your HTTPS tunnel URL (no trailing slash).
# Allowed redirection URL(s) in Partners must include:
#   {SHOPIFY_APP_URL}/authenticate
#
# Admin API access scopes in Partners must include the scopes listed in
# SHOPIFY_API_SCOPES (then reinstall/re-auth the app on the store).

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_NAME="Shopify Laravel Starter"
SHOPIFY_APP_URL=https://your-tunnel-subdomain.ngrok-free.dev
SHOPIFY_API_VERSION=2026-07
SHOPIFY_API_SCOPES=read_products,write_products

# Required for current Shopify Admin API offline tokens
SHOPIFY_EXPIRING_OFFLINE_TOKENS=true
SHOPIFY_AUTO_MIGRATE_LEGACY=true

# Optional
# SHOPIFY_API_REDIRECT=/authenticate
# SHOPIFY_DEBUG=false
