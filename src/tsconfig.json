{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",

        "jsx": "react-jsx",

        "strict": true,
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,

        "resolveJsonModule": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,

        "paths": {
            "@/*": ["./resources/js/*"]
        },

        "types": ["vite/client"]
    },

    "include": ["resources/js/**/*", "resources/**/*.d.ts"]
}
